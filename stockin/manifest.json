{
  "name": "Birkhill Deliveries and Suppliers",
  "short_name": "Deliveries",
  "display": "standalone",
  "theme_color": "#17643F",
  "background_color": "#17643F",
  "start_url": "./",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "scope": "./",
  "id": "./",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "invoice",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            "text/csv",
            ".csv",
            "text/plain",
            ".txt",
            ".edn",
            "application/xml",
            ".xml"
          ]
        }
      ]
    }
  }
}
